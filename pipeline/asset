#!/usr/bin/env bash
# pipeline/asset <command> ... — the commands are in pipeline/ASSET.md
set -u
here="$(cd "$(dirname "$0")" && pwd)"
BLENDER="${BLENDER:-$HOME/opt/blender/blender}"
# The sampler warning is the exporter counting material.baked's one ORM image node once per channel.
NOISE='^(Color management|Read blend|Blender quit|Blender [0-9.]+ |INFO Draco|$)|\| INFO: |\| WARNING: More than one shader node tex image'

blend() {
  "$BLENDER" --background --factory-startup --quiet --python-exit-code 1 \
    --python "$here/lib/cli.py" -- "$@" 2>&1 | grep -vE "$NOISE"
  return "${PIPESTATUS[0]}"
}

if [[ "${1:-}" == build ]]; then
  blend build "${@:2}" || exit $?
  blend check "${@:2}"
  status=$?
  blend review "${@:2}" || exit $?
  exit "$status"
fi
blend "$@"
